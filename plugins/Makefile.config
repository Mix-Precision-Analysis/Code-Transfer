# LLVM/Clang root
export LLVM_PATH := /opt/llvm-17.0.6

# Tooling
CXX         := $(LLVM_PATH)/bin/clang++
LLVM_CONFIG := $(LLVM_PATH)/bin/llvm-config

# Sources
SRC_DIR ?= $(PWD)

# Flags
COMMON_FLAGS := -Wall -O3 -g -fPIC -DFPC_DEBUG
CLANG_SRC_INCLUDE   := $(LLVM_PATH)/../clang/include
CLANG_BUILD_INCLUDE := $(LLVM_PATH)/tools/clang/include

CXXFLAGS += $(COMMON_FLAGS) $(shell $(LLVM_CONFIG) --cxxflags)
CPPFLAGS += $(shell $(LLVM_CONFIG) --cppflags) -I$(SRC_DIR) -I$(CLANG_SRC_INCLUDE) -I$(CLANG_BUILD_INCLUDE)
LDFLAGS  += $(shell $(LLVM_CONFIG) --ldflags)

SHARED_LIB_OPT := -shared -Wl,-O1 -undefined dynamic_lookup

# Install prefix (unused by default)
prefix := ./lib
